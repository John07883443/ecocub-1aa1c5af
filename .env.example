# Образец окружения. Скопировать в .env на сервере и заполнить.
# Сам .env в репозиторий не коммитится — он в .gitignore.

# Куда класть базу заявок.
#
# ВАЖНО: путь должен быть ВНЕ каталога деплоя. deploy.sh тасует .output и
# .output.prev, поэтому база, положенная рядом с приложением, будет затёрта
# очередной сборкой или уедет вместе с откатом — вместе со всеми заявками.
#
# Каталог создаётся автоматически при первой заявке; процессу приложения
# нужны права на запись в него:
#   sudo mkdir -p /var/lib/ecocub && sudo chown deploy:deploy /var/lib/ecocub
#
# Значение по умолчанию, если переменная не задана: /var/lib/ecocub/leads.db
LEADS_DB_PATH=/var/lib/ecocub/leads.db

# База с карточками проектов (Supabase, только контент — не персональные данные).
#
# Читает их сервер, в браузер значения не попадают: запрос идёт через серверную
# функцию. Ключ нужен именно `anon` — он публичный по своей природе, а политика
# в базе разрешает ему только чтение опубликованных карточек. Ключ service_role
# здесь не нужен и появиться не должен.
#
# Если переменные не заданы, сайт берёт карточки из content/projects/*.json.
# Это же происходит при недоступности базы, так что витрина не падает.
SUPABASE_URL=https://engcousgbyrksujobyml.supabase.co
SUPABASE_ANON_KEY=

# Уведомления о заявках в Telegram. Если не заданы — заявки просто пишутся
# в базу без уведомления. В браузер эти значения не попадают.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Режим «Проектирование» (CAD Light, /design).
#
# Секрет, которым владелец входит в редактор. Пока переменная не задана,
# создание, изменение и публикация проектов ЗАКРЫТЫ на боевом сервере для
# всех — открытый на запись endpoint хуже неработающей админки. В локальной
# разработке (NODE_ENV != production) правки в этом случае разрешены без
# входа, о чём пишется предупреждение в лог.
#
# Требование одно: не короче 16 символов. Секрет в браузер не передаётся —
# после входа выдаётся подписанная HttpOnly-кука на 12 часов. Смена секрета
# обесценивает все выданные куки, то есть работает как «выйти везде».
ECOCUB_ADMIN_SECRET=

# База проектов CAD Light: модели домов, карточки каталога и обложки.
#
# Тот же принцип, что и у заявок: путь должен указывать ВНЕ каталога деплоя,
# иначе база уедет вместе с откатом. Каталог создаётся автоматически, процессу
# нужны права на запись.
#
# Значение по умолчанию: /var/lib/ecocub/house-projects.db
HOUSE_PROJECTS_DB_PATH=/var/lib/ecocub/house-projects.db
