{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eco-cub.ru/schema/reference-project-manifest-1.json",
  "title": "EcoCub reference project manifest",
  "description": "Нормализованная карточка проверенного проекта EcoCub/Cubox. Версия схемы 1.",
  "type": "object",
  "required": ["schemaVersion", "id", "source", "status", "verified", "metrics", "floors"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "source": { "enum": ["EcoCub", "Cubox"] },
    "status": { "enum": ["concept", "designed", "produced", "built"] },
    "verified": {
      "type": "boolean",
      "description": "Данные проверены человеком. Только true участвует в подборе."
    },
    "verifiedAt": { "type": "string", "format": "date" },
    "region": {
      "type": "string",
      "description": "Обезличенный регион или климатическая зона. Адреса запрещены."
    },
    "metrics": {
      "type": "object",
      "required": ["moduleSideM", "ceilingHeightM", "floors", "totalAreaM2"],
      "additionalProperties": false,
      "properties": {
        "moduleSideM": { "type": "number", "exclusiveMinimum": 0 },
        "ceilingHeightM": { "type": "number", "exclusiveMinimum": 0 },
        "floors": { "type": "integer", "minimum": 1 },
        "moduleCount": { "type": "integer", "minimum": 1 },
        "totalAreaM2": { "type": "number", "exclusiveMinimum": 0 },
        "livingAreaM2": { "type": "number", "minimum": 0 },
        "terraceAreaM2": { "type": "number", "minimum": 0 },
        "bedrooms": { "type": "integer", "minimum": 0 },
        "bathrooms": { "type": "integer", "minimum": 0 }
      }
    },
    "floors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["floor", "modules", "rooms"],
        "additionalProperties": false,
        "properties": {
          "floor": { "type": "integer", "minimum": 0 },
          "modules": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "x", "z", "roomId"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string" },
                "x": { "type": "number" },
                "z": { "type": "number" },
                "roomId": { "type": "string" }
              }
            }
          },
          "rooms": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "type"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string" },
                "type": {
                  "enum": [
                    "entryway",
                    "living",
                    "kitchen",
                    "dining",
                    "bedroom",
                    "office",
                    "bathroom",
                    "storage",
                    "stairs",
                    "terrace"
                  ]
                },
                "name": { "type": "string" },
                "areaM2": { "type": "number", "minimum": 0 }
              }
            }
          },
          "openings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "x", "z", "widthM", "axis"],
              "additionalProperties": false,
              "properties": {
                "kind": { "enum": ["door", "window", "entry", "opening"] },
                "x": { "type": "number" },
                "z": { "type": "number" },
                "widthM": { "type": "number", "exclusiveMinimum": 0 },
                "axis": { "enum": ["x", "z"] }
              }
            }
          },
          "furniture": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "x", "z", "w", "d", "rotation"],
              "additionalProperties": false,
              "properties": {
                "kind": { "type": "string" },
                "roomId": { "type": "string" },
                "x": { "type": "number" },
                "z": { "type": "number" },
                "w": { "type": "number", "exclusiveMinimum": 0 },
                "d": { "type": "number", "exclusiveMinimum": 0 },
                "rotation": { "enum": [0, 90, 180, 270] }
              }
            }
          }
        }
      }
    },
    "facade": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "styleId": { "type": "string" },
        "materials": { "type": "array", "items": { "type": "string" } },
        "palette": { "type": "array", "items": { "type": "string" } }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceFiles": { "type": "array", "items": { "type": "string" } },
        "previews": { "type": "array", "items": { "type": "string" } }
      }
    },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
